# Optional. The room works without this file: it plays councils you run in Antigravity or Claude Code.
#
# To let the room run councils by itself from the Web UI or CLI (npm run roast),
# copy this file to .env and configure either Gemini or Anthropic:

# Google Gemini API key (recommended for Antigravity)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Models (optional, defaults to gemini-2.5-flash for seats and gemini-2.5-pro for chair)
GEMINI_SEAT_MODEL=gemini-2.5-flash
GEMINI_CHAIR_MODEL=gemini-2.5-pro

# Anthropic API key (optional alternative)
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# SEAT_MODEL=claude-sonnet-5-5
# CHAIR_MODEL=claude-opus-5-5

# Provider preference: "gemini" or "anthropic" (auto-detected if unset)
AI_PROVIDER=

# Council Runner mode: "viewer" (watches sessions/ written by Antigravity) or "api" (runs via API in web UI/CLI)
# Automatically enables "api" when an API key is provided.
COUNCIL_RUNNER=

# Used by /newroaster to make a new advisor's cartoon portrait (about 5 image jobs each).
# Get a key at https://kie.ai/api-key
KIE_AI_API_KEY=
